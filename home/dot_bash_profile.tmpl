export TERM=xterm-256color
export MYVIMRC="$HOME/.vimrc"

{{ if eq .chezmoi.os "windows" -}}
# C:\Program Files\Go などのシステムのツールより、mise のものを優先する
export PATH="$HOME/.local/bin:$HOME/AppData/Local/mise/shims:$PATH"
{{ else -}}
export PATH="$HOME/.local/bin:$HOME/go/bin:$HOME/.local/share/mise/shims:$PATH"
{{ end -}}

[ -f "$HOME/.bashrc" ] && . "$HOME/.bashrc"
