#!/bin/bash
# ソースが変わったら再実行される:
# {{ include ".hooks-src/block-signing-bypass/main.go" | sha256sum }}
# {{ include ".hooks-src/block-signing-bypass/main_test.go" | sha256sum }}
# {{ include ".hooks-src/block-signing-bypass/go.mod" | sha256sum }}
# {{ include ".hooks-src/ja-style/main.go" | sha256sum }}
# {{ include ".hooks-src/ja-style/main_test.go" | sha256sum }}
# {{ include ".hooks-src/ja-style/go.mod" | sha256sum }}
# テストが通ったときだけ、別名でビルドしてから置き換える (実行中のセッションが書きかけを起動しないように)。
set -euo pipefail

mise="$HOME/.local/bin/mise"
for hook in block-signing-bypass ja-style; do
  cd {{ joinPath .chezmoi.sourceDir ".hooks-src" | quote }}/"$hook"
  dst="$HOME/.claude/hooks/$hook"
  "$mise" exec go -- go test ./...
  mkdir -p "$(dirname "$dst")"
  "$mise" exec go -- go build -o "$dst.tmp" .
  mv -f "$dst.tmp" "$dst"
done
