[user]
	name = {{ .name }}
	email = {{ .email }}
{{- if and (eq .profile "main") .signingKey }}
	signingkey = {{ .signingKey }}
{{- end }}
[core]
	editor = vim -c \"set fenc=utf-8\"
	ignorecase = false
	quotepath = false
	autocrlf = input
[color]
	diff = auto
	status = auto
	branch = auto
	ui = true
[push]
	default = simple
[merge]
	tool = vimdiff
	conflictstyle = diff3
[mergetool]
	prompt = false
{{- if eq .profile "main" }}
{{- /* 後に書いた値が勝つので、~/.gitconfig.local と、そこから読むファイルでは、署名の設定を変えられない */}}
[include]
	path = ~/.gitconfig.local
[commit]
	gpgsign = true
[gpg]
	program = gpg
{{- end }}
