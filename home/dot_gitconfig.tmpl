[user]
	name = {{ .name }}
	email = {{ .email }}
[core]
	editor = vim -c \"set fenc=utf-8\"
	ignorecase = false
	quotepath = false
	autocrlf = input
[color]
	diff = auto
	status = auto
	branch = auto
	ui = true
[push]
	default = simple
[merge]
	tool = vimdiff
	conflictstyle = diff3
[mergetool]
	prompt = false
{{- if eq .profile "main" }}
{{- /* 後に書いた値が勝つので、~/.gitconfig.local と、そこから読むファイルでは、署名の設定 (有効か、鍵、形式、プログラム) を変えられない。鍵は、signingKey があるときだけ */}}
[include]
	path = ~/.gitconfig.local
{{- if .signingKey }}
[user]
	signingkey = {{ .signingKey }}
{{- end }}
[commit]
	gpgsign = true
[gpg]
	format = openpgp
	program = gpg
{{- end }}
