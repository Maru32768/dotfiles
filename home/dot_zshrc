export LANG=ja_JP.UTF-8

HISTFILE=~/.zsh_history
HISTSIZE=1000000
SAVEHIST=1000000
setopt extended_history share_history hist_ignore_all_dups hist_ignore_space hist_reduce_blanks
alias history='history -t "%F %T"'

PROMPT='%F{blue}%n:%f %~/ %# '

autoload -Uz vcs_info add-zsh-hook
zstyle ':vcs_info:*' formats '%F{green}(%s)-[%b]%f'
zstyle ':vcs_info:*' actionformats '%F{red}(%s)-[%b|%a]%f'
_update_vcs_info_msg() {
  LANG=en_US.UTF-8 vcs_info
  RPROMPT="${vcs_info_msg_0_}"
}
add-zsh-hook precmd _update_vcs_info_msg

# / も単語の区切りにして、^W でディレクトリを 1 つずつ消せるようにする
autoload -Uz select-word-style
select-word-style default
zstyle ':zle:*' word-chars " /=;@:{},|"
zstyle ':zle:*' word-style unspecified

autoload -Uz compinit && compinit
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
zstyle ':completion:*' ignore-parents parent pwd ..
zstyle ':completion:*:sudo:*' command-path /usr/local/sbin /usr/local/bin /usr/sbin /usr/bin /sbin /bin
zstyle ':completion:*:processes' command 'ps x -o pid,s,args'

setopt print_eight_bit no_beep no_flow_control ignore_eof interactive_comments
setopt auto_cd auto_pushd pushd_ignore_dups extended_glob

bindkey '^R' history-incremental-pattern-search-backward

export CLICOLOR=1
alias ls='ls -G -F'
alias la='ls -a'
alias ll='ls -l'
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'
alias mkdir='mkdir -p'
# 末尾のスペースで、sudo の後ろのエイリアスも展開する
alias sudo='sudo '
alias -g L='| less'
alias -g G='| grep'
alias -g C='| pbcopy'

command -v mise >/dev/null && eval "$(mise activate zsh)"
export GPG_TTY=$(tty)

if [ -f ~/.zshrc.local ]; then . ~/.zshrc.local; fi
