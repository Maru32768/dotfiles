{{- /* chezmoi:modify-template */ -}}
{{- /* Claude Code 自身も書き換えるので、共通設定を既存の内容へマージする。環境固有のキーは残り、同じキーは共通設定が優先される (配列は丸ごと置き換わる)。 */ -}}
{{- $current := dict -}}
{{- if .chezmoi.stdin -}}
{{-   $current = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $shared := include ".claude-settings.json" | fromJson -}}
{{- /* review-loop の台帳の置き場 (docs/claude.md)。~ で書いたパスを展開するかは文書にないので、絶対パスにする */ -}}
{{- $shared = mergeOverwrite $shared (dict "permissions" (dict "additionalDirectories" (list (printf "%s/.local/state/review-loop" .chezmoi.homeDir)))) -}}
{{ mergeOverwrite $current $shared | toPrettyJson "  " }}
