{{ if eq .chezmoi.os "darwin" -}}
# Homebrew の openssh など、Apple 以外の ssh が UseKeychain で止まらないようにする
IgnoreUnknown UseKeychain

{{ end -}}
Host github github.com
    HostName github.com
    IdentityFile ~/.ssh/github
    IdentitiesOnly yes
{{- if eq .chezmoi.os "darwin" }}
    AddKeysToAgent yes
    UseKeychain yes
{{- end }}

# 先頭に置くと、Host * の IdentityFile が GitHub の鍵より先に試される。Host の外で読むように Match all を挟む
Match all
Include config.local
