{{- $cmd := printf "\"%s\"" (joinPath .chezmoi.homeDir ".agents" "hooks" "block-signing-bypass") -}}
{{- if eq .chezmoi.os "windows" -}}
{{-   $bin := printf "%s.exe" (joinPath .chezmoi.homeDir ".agents" "hooks" "block-signing-bypass") | replace "/" "\\" -}}
{{-   $cmd = printf "cmd.exe /c \"%s\"" $bin -}}
{{- end -}}
{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": {{ $cmd | toJson }},
            "timeout": 10
          }
        ]
      }
    ]
  }
}
