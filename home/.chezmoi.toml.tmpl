{{- /* chezmoi init をやり直しても、環境変数がなければ今のプロファイルを保つ。agent が main に戻らないように */ -}}
{{- $profile := env "DOTFILES_PROFILE" | default (get . "profile") | default "main" -}}
{{- /* host: windows、wsl (WSL のインスタンス)、desktop (WSL ではない Linux の PC)、mac。Linux では WSL のカーネルかどうかで決める。
       CI のコンテナはどちらのカーネルでも動くので、DOTFILES_HOST で指定する */ -}}
{{- $host := "windows" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $host = "mac" -}}
{{- else if ne .chezmoi.os "windows" -}}
{{-   $detected := "desktop" -}}
{{-   if contains "microsoft" (lower (dig "kernel" "osrelease" "" .chezmoi)) -}}
{{-     $detected = "wsl" -}}
{{-   end -}}
{{-   $host = env "DOTFILES_HOST" | default (get . "host") | default $detected -}}
{{-   if not (has $host (list "wsl" "desktop")) -}}
{{-     fail (printf "DOTFILES_HOST は wsl か desktop: %s" $host) -}}
{{-   end -}}
{{- end -}}
{{- if and (has $host (list "desktop" "mac")) (ne $profile "main") -}}
{{-   fail (printf "agent と research は WSL のインスタンスにだけ作る (docs/%s.md)" $host) -}}
{{- end -}}
{{- /* Windows と WSL は同じ鍵で署名する。desktop と mac は PC ごとの鍵を DOTFILES_SIGNING_KEY で渡す。provision/setup-credentials.sh が作る */ -}}
{{- $mainSigningKey := "78324D99D34D3111" -}}
{{- $signingKey := $mainSigningKey -}}
{{- if has $host (list "desktop" "mac") -}}
{{-   $signingKey = env "DOTFILES_SIGNING_KEY" | default (get . "signingKey") | default "" -}}
{{- end -}}
{{- $w := env "DOTFILES_WORK" | default (ternary "1" "0" (get . "work" | default false)) -}}
{{- if not (has $w (list "1" "0")) }}{{ fail (printf "DOTFILES_WORK は 1 か 0: %s" $w) }}{{ end -}}
sourceDir = "{{ .chezmoi.sourceDir | trimSuffix "/home" }}"

[data]
    # main: 普段の開発環境 / agent: Claude を動かす使い捨て環境
    profile = "{{ $profile }}"
    host = "{{ $host }}"
    name = "Maru32768"
    email = "maru32768@gmail.com"
    signingKey = "{{ $signingKey }}"
    # 仕事の PC だけ true にして、仕事用のファイルを置く。DOTFILES_WORK=1 か 0 を付けた chezmoi init で変える
    work = {{ eq $w "1" }}
