{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "claude-security@claude-plugins-official": true,
    "pstack@pstack-claude": true,
    "mattpocock-skills@mattpocock": true,
    "ronny@mcode-stack": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail",
        "ref": "ebd8654c2c627f721eb8f9c0d1bd4090a29f9e10"
      },
      "autoUpdate": true
    },
    "pstack-claude": {
      "source": {
        "source": "github",
        "repo": "michael-denyer/pstack-claude",
        "ref": "97d2ba2790822939ee43db0d7856219ea96c450d"
      },
      "autoUpdate": true
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills",
        "ref": "abeeaf95660ba9e8b7c753eb38f441ca707a8823"
      },
      "autoUpdate": true
    },
    "mcode-stack": {
      "source": {
        "source": "github",
        "repo": "MiniMax-AI/mcode-stack",
        "ref": "0db1b4fb3b6270e173080d87b72c28516b299ddd"
      },
      "autoUpdate": true
    }
  },
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipWorkflowUsageWarning": true,
  "autoCompactWindow": 500000,
  "idleCompaction": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --script \"$HOME/.local/bin/usage-log\" collect --quiet",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/block-signing-bypass\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/block-antigravity\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/ja-style\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
