{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "claude-security@claude-plugins-official": true,
    "pstack@pstack-claude": true,
    "pstack@cursor-plugins": false,
    "mattpocock-skills@mattpocock": true,
    "humanizer@humanizer": true,
    "ronny@mcode-stack": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "pstack-claude": {
      "source": {
        "source": "github",
        "repo": "michael-denyer/pstack-claude"
      }
    },
    "cursor-plugins": {
      "source": {
        "source": "git",
        "url": "https://github.com/cursor/plugins.git"
      }
    },
    "mattpocock": {
      "source": {
        "source": "git",
        "url": "https://github.com/mattpocock/skills.git"
      }
    },
    "humanizer": {
      "source": {
        "source": "git",
        "url": "https://github.com/blader/humanizer.git"
      }
    },
    "mcode-stack": {
      "source": {
        "source": "github",
        "repo": "MiniMax-AI/mcode-stack"
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipWorkflowUsageWarning": true,
  "autoCompactWindow": 500000,
  "idleCompaction": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --script \"$HOME/.local/bin/usage-log\" collect --quiet",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/block-signing-bypass\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
