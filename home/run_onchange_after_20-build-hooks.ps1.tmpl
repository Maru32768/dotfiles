# Runs again when the source changes:
# {{ include ".hooks-src/block-signing-bypass/main.go" | sha256sum }}
# {{ include ".hooks-src/block-signing-bypass/main_test.go" | sha256sum }}
# {{ include ".hooks-src/block-signing-bypass/go.mod" | sha256sum }}
# {{ include ".hooks-src/ja-style/main.go" | sha256sum }}
# {{ include ".hooks-src/ja-style/main_test.go" | sha256sum }}
# {{ include ".hooks-src/ja-style/go.mod" | sha256sum }}
# Replaces each binary only after its tests pass. A running session may hold the
# old binary open for a moment, so the rename is retried.
$ErrorActionPreference = 'Stop'

$targets = @(
    @{ Name = 'block-signing-bypass'; Dest = (Join-Path $HOME '.agents\hooks\block-signing-bypass.exe') }
    @{ Name = 'ja-style'; Dest = (Join-Path $HOME '.claude\hooks\ja-style.exe') }
)

foreach ($target in $targets) {
    $hook = $target.Name
    $dst = $target.Dest
    Set-Location (Join-Path {{ joinPath .chezmoi.sourceDir ".hooks-src" | quote }} $hook)

    & mise exec go -- go test ./...
    if ($LASTEXITCODE -ne 0) { throw "$hook tests failed: $LASTEXITCODE" }

    New-Item -ItemType Directory -Force -Path (Split-Path $dst) | Out-Null
    & mise exec go -- go build -o "$dst.tmp" .
    if ($LASTEXITCODE -ne 0) { throw "$hook build failed: $LASTEXITCODE" }

    foreach ($attempt in 1..5) {
        try {
            Move-Item -Force "$dst.tmp" $dst
            break
        } catch {
            if ($attempt -eq 5) { throw }
            Start-Sleep -Seconds 1
        }
    }
}

Remove-Item -Force -ErrorAction SilentlyContinue (Join-Path $HOME '.claude\hooks\block-signing-bypass.exe')
